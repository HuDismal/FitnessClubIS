<Window x:Class="FitnessClubIS.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FitnessClubIS.ViewModels"
        Style="{StaticResource BaseWindow}"
        Title="Атлет — информационная система фитнес-клуба" Width="1180" Height="720" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Resources/Icons/app.ico">
    <Window.DataContext>
        <vm:MainWindowViewModel/>
    </Window.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== меню ===== -->
        <DockPanel Background="{StaticResource PrimaryBrush}">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="14,16,14,18">
                <Image Source="pack://application:,,,/Resources/Images/icon.png" Width="40" Height="40"/>
                <TextBlock Text="АТЛЕТ" Foreground="White" FontSize="22" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- панель пользователя -->
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="12,12,12,16">
                <StackPanel Margin="0,0,6,0" VerticalAlignment="Center" Width="140">
                    <TextBlock Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0} {1}">
                                <Binding Path="Account.LastName"/>
                                <Binding Path="Account.FirstName"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock Text="{Binding Account.AccountType.Name}" Foreground="#CFE6D9" FontSize="12"/>
                </StackPanel>
                <Button Style="{StaticResource ExitButton}" Click="ExitButton_Click" ToolTip="Выйти"/>
            </StackPanel>

            <!-- панель навигации -->
            <ListBox ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedItem}"
                     ItemContainerStyle="{StaticResource NavItem}" Background="Transparent" BorderThickness="0"
                     SelectionChanged="NavList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Icon}" Width="28" FontSize="16"/>
                            <TextBlock Text="{Binding Title}" FontSize="15"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- ===== рабочая область ===== -->
        <Frame x:Name="MainFrame" Grid.Column="1" NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>
