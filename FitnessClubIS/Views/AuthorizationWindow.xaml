<Window x:Class="FitnessClubIS.Views.AuthorizationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FitnessClubIS.ViewModels"
        Style="{StaticResource BaseWindow}"
        Title="Атлет — вход в систему" Width="420" Height="520"
        ResizeMode="NoResize" WindowStyle="SingleBorderWindow" WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Resources/Icons/app.ico">
    <Window.DataContext>
        <vm:AuthorizationViewModel/>
    </Window.DataContext>
    <StackPanel Margin="40,24">
        <Image Style="{StaticResource LogoImage}" HorizontalAlignment="Center" Margin="0" Width="96" Height="96"/>
        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" HorizontalAlignment="Center" Margin="0,10,0,18"/>

        <TextBlock Text="Логин" Margin="0,0,0,4"/>
        <TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

        <TextBlock Text="Пароль" Margin="0,0,0,4"/>
        <PasswordBox x:Name="PasswordInput" Margin="0,0,0,10"/>

        <!-- капча -->
        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8" Height="46" Margin="0,4,0,6">
            <TextBlock Text="{Binding CaptchaText}" FontFamily="Consolas" FontSize="26" FontStyle="Italic"
                       FontWeight="Bold" Foreground="#4B5A53" TextDecorations="Strikethrough"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBox Text="{Binding CaptchaInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>

        <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerBrush}" Height="20"/>
        <Button Content="Войти" Click="LogInButton_Click" IsDefault="True" Margin="0,8,0,0"/>
    </StackPanel>
</Window>
