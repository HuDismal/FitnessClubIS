<UserControl x:Class="FitnessClubIS.Views.Controls.LabeledTextBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <StackPanel Margin="0,0,0,10">
        <TextBlock Text="{Binding Label, ElementName=Root}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,3"/>
        <TextBox Text="{Binding Text, ElementName=Root, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
    </StackPanel>
</UserControl>
