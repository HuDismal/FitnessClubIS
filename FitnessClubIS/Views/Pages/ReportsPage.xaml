<Page x:Class="FitnessClubIS.Views.Pages.ReportsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="clr-namespace:FitnessClubIS.ViewModels"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      Title="Отчёты">
    <Page.DataContext>
        <vm:ReportsViewModel/>
    </Page.DataContext>
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" Grid.ColumnSpan="2"/>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Период с" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <DatePicker SelectedDate="{Binding DateFrom, Mode=TwoWay}" Width="200" Height="34" VerticalContentAlignment="Center"/>
            <TextBlock Text="по" VerticalAlignment="Center" Margin="12,0,8,0"/>
            <DatePicker SelectedDate="{Binding DateTo, Mode=TwoWay}" Width="200" Height="34" VerticalContentAlignment="Center"/>
            <TextBlock Text="{Binding Total}" VerticalAlignment="Center" Margin="24,0,0,0" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
        </StackPanel>

        <StackPanel Grid.Row="2">
            <TextBlock Text="Выручка по месяцам" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <lvc:CartesianChart Series="{Binding RevenueSeries}" XAxes="{Binding XAxes}" Height="320"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Grid.Column="1" Margin="16,0,0,0">
            <TextBlock Text="Посещения по направлениям" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <lvc:PieChart Series="{Binding VisitsSeries}" Height="320" LegendPosition="Right"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="Отчёт в Word" Command="{Binding ExportCommand}"/>
            <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="{StaticResource MutedBrush}"/>
        </StackPanel>
    </Grid>
</Page>
