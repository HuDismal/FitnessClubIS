<Page x:Class="FitnessClubIS.Views.Pages.ClientsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="clr-namespace:FitnessClubIS.ViewModels"
      Title="Клиенты">
    <Page.DataContext>
        <vm:ClientsViewModel/>
    </Page.DataContext>
    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}"/>

        <!-- панель поиска, фильтрации и сортировки -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,12">
            <StackPanel Margin="0,0,12,8">
                <TextBlock Text="Поиск (фамилия, имя, телефон)" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                <TextBox Width="260" Text="{Binding SearchString, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="0,0,12,8">
                <TextBlock Text="Фильтр" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                <ComboBox Width="220" ItemsSource="{Binding Filters}" SelectedIndex="{Binding SelectedFilter}"/>
            </StackPanel>
            <StackPanel Margin="0,0,12,8">
                <TextBlock Text="Сортировка" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                <ComboBox Width="250" ItemsSource="{Binding Sorts}" SelectedIndex="{Binding SelectedSort}"/>
            </StackPanel>
            <Button Content="Сбросить" Command="{Binding ResetCommand}" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
        </WrapPanel>

        <!-- вкладки: карточки / таблица -->
        <TabControl Grid.Row="2" BorderThickness="0" Padding="0">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <DockPanel>
                        <StackPanel x:Name="HeaderPanel" DockPanel.Dock="Top" Orientation="Horizontal" IsItemsHost="True"/>
                        <ContentPresenter ContentSource="SelectedContent"/>
                    </DockPanel>
                </ControlTemplate>
            </TabControl.Template>

            <!-- вкладка 1: шаблон отображения (карточки) -->
            <TabItem Style="{StaticResource IconTab}" ToolTip="Карточки">
                <TabItem.Header>
                    <Path Data="{StaticResource IconCards}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" Width="22" Height="22" Stretch="Uniform"/>
                </TabItem.Header>
                <ListBox ItemsSource="{Binding Clients}" SelectedItem="{Binding SelectedClient}"
                         ItemContainerStyle="{StaticResource CardItem}" BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="230">
                                <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Phone}" Margin="0,6,0,0"/>
                                <TextBlock Text="{Binding Email}" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                                <TextBlock Text="{Binding BirthDate, StringFormat='Дата рождения: {0:dd.MM.yyyy}'}" FontSize="12" Margin="0,6,0,0"/>
                                <TextBlock Text="{Binding MembershipText}" FontSize="12" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>

            <!-- вкладка 2: таблица -->
            <TabItem Style="{StaticResource IconTab}" ToolTip="Таблица">
                <TabItem.Header>
                    <Path Data="{StaticResource IconTable}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"
                          Width="22" Height="22" Stretch="Uniform" StrokeThickness="1.6"/>
                </TabItem.Header>
                <DataGrid ItemsSource="{Binding Clients}" SelectedItem="{Binding SelectedClient}"
                          AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" CanUserSortColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="2*"/>
                        <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="*"/>
                        <DataGridTextColumn Header="E-mail" Binding="{Binding Email}" Width="*"/>
                        <DataGridTextColumn Header="Дата рождения" Binding="{Binding BirthDate, StringFormat=dd.MM.yyyy}" Width="Auto"/>
                        <DataGridTextColumn Header="Регистрация" Binding="{Binding RegisteredAt, StringFormat=dd.MM.yyyy}" Width="Auto"/>
                        <DataGridTextColumn Header="Абонемент" Binding="{Binding MembershipText}" Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <!-- панель действий -->
        <DockPanel Grid.Row="3" Margin="0,12,0,0" LastChildFill="False">
            <TextBlock Text="{Binding Counter}" DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
            <Button Content="Удалить" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}" DockPanel.Dock="Right"/>
            <Button Content="Изменить" Command="{Binding EditCommand}" DockPanel.Dock="Right" Margin="0,0,8,0"/>
            <Button Content="Добавить" Command="{Binding AddCommand}" DockPanel.Dock="Right" Margin="0,0,8,0"/>
        </DockPanel>
    </Grid>
</Page>
