<Window x:Class="FitnessClubIS.Views.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource BaseWindow}"
        ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" Width="400" SizeToContent="Height" ShowInTaskbar="False">
    <Border Margin="12" Background="White" CornerRadius="14" BorderBrush="#D5DED9" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" Opacity="0.3" ShadowDepth="3"/>
        </Border.Effect>
        <StackPanel>
            <TextBlock x:Name="IconText" FontSize="40" HorizontalAlignment="Center" Margin="0,18,0,0"/>
            <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="12,6,12,0"/>
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" TextAlignment="Center" Margin="20,8,20,18" Foreground="{StaticResource MutedBrush}"/>
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="0,0,14,14" Height="60">
                <StackPanel x:Name="ButtonsPanel" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </StackPanel>
    </Border>
</Window>
